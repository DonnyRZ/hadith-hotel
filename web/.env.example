# Copy to .env and adjust if needed
# Start database: from repo root → docker compose up -d db

DATABASE_URL="postgresql://hadith:hadith@localhost:5432/hadith_hotel?schema=public"

# HMAC secret for hashing visitor IPs (never store raw IPs). Generate a long random string.
VISITOR_IP_HASH_SECRET=""

# Geolookup URL template; `{ip}` is replaced with the client address.
VISITOR_GEOLOOKUP_URL="https://ipwho.is/{ip}"

# Optional comma-separated major-city allowlist (falls back to built-in ID + UZ cities).
VISITOR_MAJOR_CITIES=

# Set true only behind Cloudflare so cf-connecting-ip is trusted for identity.
VISITOR_TRUST_CLOUDFLARE_HEADERS=false
